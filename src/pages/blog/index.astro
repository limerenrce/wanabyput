---
import { getCollection } from 'astro:content';
import SiteLayout from '@/layouts/SiteLayout.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import JournalCard from '@/components/JournalCard.astro';
const posts = (await getCollection('blog', ({data}) => !data.draft)).sort((a,b) => b.data.pubDate.valueOf()-a.data.pubDate.valueOf());
---
<SiteLayout title="The WANA journal" description="Notes on slower island days, thoughtful spa rituals, and making space for yourself. Read the journal from WANA Spa, coming soon near Crystal Bay." image="details" breadcrumbs={[{label:'Journal'}]}>
  <div class="wrap"><Breadcrumbs items={[{label:'Journal'}]}/><div class="page-heading" data-reveal><p class="eyebrow">NOTES FROM WANA</p><h1>A slower<br/><em>point of view.</em></h1><p class="copy">Little observations, thoughtful rituals, and a few ideas for making room in your day. No rush to read them all.</p></div><div class="journal-grid">{posts.map(post => <JournalCard post={post}/>)}</div><div style="height:88px" aria-hidden="true"></div></div>
</SiteLayout>

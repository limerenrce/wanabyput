---
import '@/styles/global.css';
import '@/styles/coming-soon.css';
import CalmScene from '@/components/CalmScene.astro';
import { getImage } from 'astro:assets';
import illustration from '@/assets/wana-spa-illustration.png';
const [small, large] = await Promise.all([
  getImage({ src: illustration, width: 960, format: 'webp', quality: 85 }),
  getImage({ src: illustration, width: 1536, format: 'webp', quality: 85 }),
]);
const title = 'Wana Spa — Coming soon';
const description = 'Wana Spa. 1st in Crystal Bay. Coming soon.';
const canonical = Astro.site && Astro.site.hostname !== 'example.com' ? new URL('/', Astro.site) : undefined;
---
<!doctype html>
<html lang="en" class="coming-soon">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#f2ebdb" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/wana-mark.svg" />
    {canonical && <link rel="canonical" href={canonical} />}
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {canonical && <meta property="og:url" content={canonical} />}
    {canonical && <meta property="og:image" content={new URL(large.src, canonical)} />}
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body class="wana-page">
    <main class="wana-canvas" aria-label="Wana Spa coming soon">
      <CalmScene imageSrc={large.src} imageSrcSet={`${small.src} 960w, ${large.src} 1536w`} />
    </main>
  </body>
</html>

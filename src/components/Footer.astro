---
import Arrow from '@/components/Arrow.astro';
import FlowerMark from '@/components/FlowerMark.astro';
import { NAV_LINKS } from '@/consts';
---
<footer class="site-footer">
  <div class="footer-invitation"><div><p class="eyebrow">A NEW CHAPTER, COMING SOON</p><h2>Your little<br/>island <em>exhale.</em></h2></div><a class="circle-link" href="/visit/" aria-label="Discover where WANA is taking shape"><Arrow/></a></div>
  <div class="footer-main"><a href="/" class="footer-wordmark" aria-label="WANA Spa home">wana<FlowerMark/></a><div class="footer-location"><p>Near Crystal Bay<br/>Nusa Penida, Bali</p><span>Coming soon</span></div><nav aria-label="Footer navigation">{NAV_LINKS.map(link => <a href={link.href}>{link.label}</a>)}</nav></div>
  <div class="footer-bottom"><span>© {new Date().getFullYear()} WANA Spa</span><p>Concept imagery throughout. <a href="/gallery/#imagery-note">About the imagery</a></p><a href="#top">Back to top ↑</a></div>
</footer>

---
import FlowerMark from '@/components/FlowerMark.astro';
---
<section class="section olive signature-section" aria-labelledby="signature-title">
  <FlowerMark class="signature-mark"/>
  <div class="wrap signature-layout">
    <div class="signature-copy" data-reveal><p class="eyebrow"><span class="eyebrow-number">02 /</span> ROOTED IN THE LITTLE THINGS</p><h2 id="signature-title">Small rituals.<br/>Deeper <em>connection.</em></h2><p class="copy">A flower. A thoughtful gesture. A moment with no agenda. Our vision begins with the simple things that make you feel present.</p></div>
    <wana-flower class="flower-stage" role="group" aria-label="An interactive three-dimensional frangipani flower">
      <div class="flower-visual"><img class="flower-poster" src="/flower-poster.svg" width="640" height="640" alt="An ivory frangipani flower with five curled petals and a warm terracotta centre." loading="lazy"/><canvas class="flower-canvas" aria-hidden="true"></canvas></div>
      <div class="flower-controls" hidden><button type="button" data-turn="-1" aria-label="Rotate flower left">←</button><button type="button" data-reset aria-label="Reset flower rotation">↺</button><button type="button" data-turn="1" aria-label="Rotate flower right">→</button><span class="flower-hint">Drag to explore. A different perspective on a little ritual.</span></div>
    </wana-flower>
  </div>
</section>
<script>
  class WanaFlower extends HTMLElement {
    private dispose?: () => void;
    private observer?: IntersectionObserver;
    private stopped = false;
    private generation = 0;
    connectedCallback() {
      this.stopped = false;
      const generation = ++this.generation;
      this.observer = new IntersectionObserver(async entries => {
        if (!entries.some(entry => entry.isIntersecting)) return;
        this.observer?.disconnect();
        try {
          const { mountFlower } = await import('@/lib/flower');
          if (!this.stopped && this.isConnected && generation === this.generation) this.dispose = mountFlower(this);
        } catch { this.dataset.fallback = 'module-unavailable'; }
      }, { rootMargin: '200px' });
      this.observer.observe(this);
    }
    disconnectedCallback() { this.stopped = true; this.generation++; this.observer?.disconnect(); this.dispose?.(); this.dispose = undefined; }
  }
  if (!customElements.get('wana-flower')) customElements.define('wana-flower', WanaFlower);
</script>

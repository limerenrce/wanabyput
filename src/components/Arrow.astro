---
interface Props { direction?: 'right' | 'up-right' | 'down'; class?: string }
const { direction = 'up-right', class: className } = Astro.props;
---
<svg class={className} width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true">
  {direction === 'up-right' && <path d="M5 19 19 5M5 5h14v14"/>}
  {direction === 'right' && <path d="M4 12h16m-6-6 6 6-6 6"/>}
  {direction === 'down' && <path d="M12 4v16m-6-6 6 6 6-6"/>}
</svg>

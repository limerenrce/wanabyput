---
interface Props { imageSrc: string; imageSrcSet: string }
const { imageSrc, imageSrcSet } = Astro.props;
---
<wana-scene class="calm-scene">
  <p class="brand-lockup"><span class="brand-name">Wana Spa</span><span class="brand-place">1st in Crystal Bay</span></p>
  <div class="water-study">
    <img class="water-image" src={imageSrc} srcset={imageSrcSet} sizes="(min-width: 768px) 480px, 88vw"
      width="1254" height="1254" alt="A whole terracotta vessel with olive water, a frangipani flower, and a submerged leaf."
      fetchpriority="high" loading="eager" decoding="async" draggable="false" />
    <canvas class="water-canvas" aria-hidden="true"></canvas>
    <button type="button" class="water-touch" aria-label="Create a ripple in the water" disabled></button>
    <span class="touch-cursor" aria-hidden="true"><svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1"><path d="M12 4v16M4 12h16"/></svg></span>
  </div>
  <h1 class="coming-title" aria-label="Coming soon"><span class="word-mask" aria-hidden="true"><span class="title-word">Coming</span></span> <span class="word-mask" aria-hidden="true"><em class="title-word">soon</em></span></h1>
  <button type="button" class="motion-control inline-flex items-center justify-center" hidden aria-label="Pause motion" aria-pressed="false">
    <svg viewBox="0 0 20 20" width="18" height="18" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.4"><path data-pause d="M7 5v10M13 5v10"/><path data-play d="m7 4 9 6-9 6Z" style="display:none"/></svg>
  </button>
</wana-scene>
<script>
  import { mountWaterStudy } from '@/lib/water-study';
  class WanaScene extends HTMLElement {
    private cleanup?: () => void;
    connectedCallback() { if (!this.cleanup) this.cleanup = mountWaterStudy(this); }
    disconnectedCallback() { this.cleanup?.(); this.cleanup = undefined; }
  }
  if (!customElements.get('wana-scene')) customElements.define('wana-scene', WanaScene);
</script>

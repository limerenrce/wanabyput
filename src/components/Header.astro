---
import MobileMenu from '@/components/interactive/MobileMenu';
import { NAV_LINKS } from '@/consts';
const pathname = Astro.url.pathname;
---
<header class="site-header">
  <a href="/" class="brand" aria-label="WANA Spa home"><span class="wordmark">wana</span><span class="brand-caption">SPA · NUSA PENIDA</span></a>
  <nav class="desktop-nav" aria-label="Main navigation">{NAV_LINKS.map(link => <a href={link.href} aria-current={pathname.startsWith(link.href) ? 'page' : undefined}>{link.label}</a>)}</nav>
  <a class="header-status" href="/visit/"><span class="status-dot" aria-hidden="true"></span>Coming soon</a>
  <div class="mobile-nav"><MobileMenu pathname={pathname} client:load /></div>
</header>
<noscript><nav class="no-script-nav" aria-label="Main navigation">{NAV_LINKS.map(link => <a href={link.href}>{link.label}</a>)}</nav></noscript>

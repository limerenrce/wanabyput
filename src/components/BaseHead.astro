---
import '@/styles/global.css';
import { getImage } from 'astro:assets';
import { photos } from '@/lib/photos';
import { SITE_TITLE, SITE_DESCRIPTION } from '@/consts';
interface Props { title: string; description?: string; noindex?: boolean; image?: keyof typeof photos; article?: { title: string; date: string }; breadcrumbs?: { label: string; href?: string }[] }
const { title, description = SITE_DESCRIPTION, noindex = false, image = 'hero-landscape', article, breadcrumbs = [] } = Astro.props;
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site) : undefined;
const social = await getImage({ src: photos[image].src, width: 1200, format: 'webp', quality: 80 });
const metaTitle = title === SITE_TITLE ? `${SITE_TITLE} — A slower kind of island time` : `${title} — ${SITE_TITLE}`;
const structured: Record<string, unknown>[] = [];
if (canonical && !noindex) {
  structured.push({ '@context': 'https://schema.org', '@type': 'WebSite', name: SITE_TITLE, url: Astro.site!.href });
  if (breadcrumbs.length) structured.push({ '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [{ label: 'Home', href: '/' }, ...breadcrumbs].map((item, i) => ({ '@type': 'ListItem', position: i + 1, name: item.label, item: new URL(item.href || Astro.url.pathname, Astro.site).href })) });
  if (article) structured.push({ '@context': 'https://schema.org', '@type': 'Article', headline: article.title, datePublished: article.date, image: new URL(social.src, Astro.site).href, author: { '@type': 'Organization', name: 'WANA Spa' }, mainEntityOfPage: canonical.href });
}
---
<meta charset="utf-8"/>
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover"/>
<meta name="theme-color" content="#2b361a"/>
<title>{metaTitle}</title>
<meta name="description" content={description}/>
<meta name="robots" content={noindex || !Astro.site ? 'noindex, follow' : 'index, follow'}/>
<link rel="icon" type="image/svg+xml" href="/wana-mark.svg"/>
{canonical && <link rel="canonical" href={canonical}/>}
{Astro.site && <><link rel="sitemap" href="/sitemap-index.xml"/><link rel="alternate" type="application/rss+xml" title="WANA Journal" href="/rss.xml"/></>}
<meta property="og:type" content={article ? 'article' : 'website'}/>
<meta property="og:site_name" content={SITE_TITLE}/>
<meta property="og:title" content={metaTitle}/>
<meta property="og:description" content={description}/>
{canonical && <><meta property="og:url" content={canonical}/><meta property="og:image" content={new URL(social.src, canonical)}/></>}
<meta name="twitter:card" content="summary_large_image"/>
{structured.map(item => <script type="application/ld+json" set:html={JSON.stringify(item).split('<').join(String.fromCharCode(92) + 'u003c')}/>)}

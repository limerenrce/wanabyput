{
  "extends": "astro/tsconfigs/strict",
  "include": [".astro/types.d.ts", "**/*"],
  "exclude": ["dist", "tmp", "qa", "node_modules"],
  "compilerOptions": {
    "strictNullChecks": true, "jsx": "react-jsx", "jsxImportSource": "react",
    "baseUrl": ".", "paths": { "@/*": ["./src/*"] }, "ignoreDeprecations": "6.0"
  }
}
